# Database defaults are disposable development values, never production credentials.
# Replace these placeholders locally; leaving them unchanged prevents app startup.
ADMIN_USERNAME='<choose-admin-username>'
ADMIN_PASSWORD='<choose-admin-password>'
APP_PORT=8080
DB_NAME=monitor
DB_USER=monitor
DB_PASSWORD=local-development-only
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
# Optional exact origin for the internal demo target; blank keeps private destinations blocked.
# Example after configuring the demo service: http://demo:8080
MONITOR_DEMO_ORIGIN=
# Single-instance scheduler: concurrency 1..16, positive polling interval in milliseconds.
MONITOR_CHECK_CONCURRENCY=4
MONITOR_SCHEDULER_POLL_MS=250
MONITOR_SCHEDULER_ENABLED=true
# Docker Desktop Linux containers / Linux Engine with host-gateway.
TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal
