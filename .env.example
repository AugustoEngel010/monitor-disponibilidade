# Database defaults are disposable development values, never production credentials.
# Replace these placeholders locally; leaving them unchanged prevents app startup.
ADMIN_USERNAME='<choose-admin-username>'
ADMIN_PASSWORD='<choose-admin-password>'
APP_PORT=8080
DB_NAME=monitor
DB_USER=monitor
DB_PASSWORD=local-development-only
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
# Optional exact origin for the internal demo target; blank keeps private destinations blocked.
# Example after configuring the demo service: http://demo:8080
MONITOR_DEMO_ORIGIN=
# Single-instance scheduler: concurrency 1..16, positive polling interval in milliseconds.
MONITOR_CHECK_CONCURRENCY=4
MONITOR_SCHEDULER_POLL_MS=250
MONITOR_SCHEDULER_ENABLED=true
# Durable single-instance notification worker, polling 1..60000 ms.
MONITOR_NOTIFICATIONS_ENABLED=true
MONITOR_NOTIFICATIONS_POLL_MS=250
# Mailpit captures fictitious recipients locally. No relay is configured.
SMTP_HOST=smtp
SMTP_PORT=1025
SMTP_FROM=monitor@example.org
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
# Finite socket timeouts, 1..60000 ms. STARTTLS is required when enabled; do not combine with SSL.
SMTP_CONNECT_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=3000
SMTP_WRITE_TIMEOUT_MS=5000
SMTP_UI_PORT=8025
SMTP_LOCAL_PORT=1025
# Docker Desktop Linux containers / Linux Engine with host-gateway.
TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal

# Retention: days 1..3650, batch-size 1..10000, polling 1000..86400000 ms.
# Each round drains successive transactions; protected evidence and dedup receipts do not expire.
MONITOR_RETENTION_ENABLED=true
MONITOR_RETENTION_DAYS=30
MONITOR_RETENTION_BATCH_SIZE=1000
MONITOR_RETENTION_POLL_MS=3600000
